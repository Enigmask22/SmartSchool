# Dockerfile.wheels
# Build Linux-compatible wheels cho các packages có vấn đề

FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libopencv-dev \
    libgl1-mesa-dev \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgthread-2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy requirements
COPY requirements.txt .

# Install build tools
RUN pip install --upgrade pip setuptools wheel

# Create wheels directory
RUN mkdir -p wheels

# Build wheels for problematic packages
RUN pip wheel \
    --wheel-dir wheels \
    opencv-python-headless==4.8.1.78 \
    insightface==0.7.3 \
    onnxruntime>=1.17.0 \
    numpy>=1.21.0 \
    pandas>=2.0.0 \
    scikit-learn==1.3.2 \
    Pillow==10.0.1

# Export wheels
VOLUME ["/build/wheels"]

CMD ["ls", "-la", "wheels/"]
